generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // Admin, Government Officer, Procurement Officer, Startup, Expert, Validator, Viewer
  description String?
  users       User[]
  createdAt   DateTime @default(now())
}

model Department {
  id          String      @id @default(uuid())
  name        String      @unique
  description String?
  users       User[]
  challenges  Challenge[]
  createdAt   DateTime    @default(now())
}

model Startup {
  id           String            @id @default(uuid())
  name         String
  description  String?
  domain       String?
  technology   String?
  users        User[]
  documents    StartupDocument[]
  applications Application[]
  pilots       PilotProject[]
  createdAt    DateTime          @default(now())
}

model User {
  id             String             @id @default(uuid())
  email          String             @unique
  password       String
  name           String
  roleId         String
  role           Role               @relation(fields: [roleId], references: [id])
  departmentId   String?
  department     Department?        @relation(fields: [departmentId], references: [id])
  startupId      String?
  startup        Startup?           @relation(fields: [startupId], references: [id])
  evaluations    Evaluation[]
  validations    ValidationRecord[]
  scaleDecisions ScaleDecision[]
  evidence       Evidence[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model StartupDocument {
  id        String   @id @default(uuid())
  startupId String
  startup   Startup  @relation(fields: [startupId], references: [id])
  name      String
  fileUrl   String
  type      String
  createdAt DateTime @default(now())
}

model Challenge {
  id           String                 @id @default(uuid())
  departmentId String
  department   Department             @relation(fields: [departmentId], references: [id])
  title        String
  description  String
  targetValue  String?
  status       String // Draft, Published, Closed
  requirements ChallengeRequirement[]
  kpis         ChallengeKPI[]
  applications Application[]
  pilots       PilotProject[]
  createdAt    DateTime               @default(now())
}

model ChallengeRequirement {
  id          String    @id @default(uuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id])
  description String
  isMandatory Boolean   @default(true)
}

model ChallengeKPI {
  id          String    @id @default(uuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id])
  name        String
  metric      String
  target      String
}

model Application {
  id          String                @id @default(uuid())
  challengeId String
  challenge   Challenge             @relation(fields: [challengeId], references: [id])
  startupId   String
  startup     Startup               @relation(fields: [startupId], references: [id])
  status      String // Applied, Shortlisted, Selected, Rejected
  documents   ApplicationDocument[]
  evaluations Evaluation[]
  pilots      PilotProject[]
  createdAt   DateTime              @default(now())
}

model ApplicationDocument {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
  name          String
  fileUrl       String
  createdAt     DateTime    @default(now())
}

model Evaluation {
  id                 String            @id @default(uuid())
  applicationId      String
  application        Application       @relation(fields: [applicationId], references: [id])
  expertId           String
  expert             User              @relation(fields: [expertId], references: [id])
  status             String // Pending, Submitted
  overallScore       Float?
  declaredNoConflict Boolean           @default(false)
  scores             EvaluationScore[]
  createdAt          DateTime          @default(now())
}

model EvaluationScore {
  id           String     @id @default(uuid())
  evaluationId String
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id])
  category     String
  score        Float
  comments     String?
}

model PilotProject {
  id            String             @id @default(uuid())
  challengeId   String
  challenge     Challenge          @relation(fields: [challengeId], references: [id])
  applicationId String
  application   Application        @relation(fields: [applicationId], references: [id])
  startupId     String
  startup       Startup            @relation(fields: [startupId], references: [id])
  status        String // Active, Completed, Failed
  baseline      String?
  target        String?
  actual        String?
  startDate     DateTime?
  endDate       DateTime?
  kpis          PilotKPI[]
  milestones    PilotMilestone[]
  payments      Payment[]
  evidence      Evidence[]
  validations   ValidationRecord[]
  passports     ProofPassport[]
  scaleDecision ScaleDecision?
  createdAt     DateTime           @default(now())
}

model PilotKPI {
  id       String       @id @default(uuid())
  pilotId  String
  pilot    PilotProject @relation(fields: [pilotId], references: [id])
  name     String
  baseline String?
  target   String?
  actual   String?
  status   String?
  evidence Evidence[]
}

model PilotMilestone {
  id          String       @id @default(uuid())
  pilotId     String
  pilot       PilotProject @relation(fields: [pilotId], references: [id])
  title       String
  dueDate     DateTime?
  amount      Float?
  status      String // Pending, Submitted, Approved, Paid
  deliverable String?
  payments    Payment[]
  evidence    Evidence[]
}

model Payment {
  id          String          @id @default(uuid())
  pilotId     String
  pilot       PilotProject    @relation(fields: [pilotId], references: [id])
  milestoneId String?
  milestone   PilotMilestone? @relation(fields: [milestoneId], references: [id])
  amount      Float
  status      String // Pending, Processed, Paid
  date        DateTime?
}

model Evidence {
  id             String          @id @default(uuid())
  pilotId        String
  pilot          PilotProject    @relation(fields: [pilotId], references: [id])
  milestoneId    String?
  milestone      PilotMilestone? @relation(fields: [milestoneId], references: [id])
  kpiId          String?
  kpi            PilotKPI?       @relation(fields: [kpiId], references: [id])
  uploadedById   String
  uploadedBy     User            @relation(fields: [uploadedById], references: [id])
  fileUrl        String
  fileType       String
  verifiedStatus String // Pending, Verified, Rejected
  createdAt      DateTime        @default(now())
}

model ValidationRecord {
  id          String       @id @default(uuid())
  pilotId     String
  pilot       PilotProject @relation(fields: [pilotId], references: [id])
  validatorId String
  validator   User         @relation(fields: [validatorId], references: [id])
  decision    String // Verify, Partially Verify, Reject
  comments    String?
  timestamp   DateTime     @default(now())
}

model ProofPassport {
  id            String       @id @default(uuid())
  pilotId       String
  pilot         PilotProject @relation(fields: [pilotId], references: [id])
  generatedDate DateTime     @default(now())
  dataSnapshot  String       // JSON stringified snapshot
}

model ScaleDecision {
  id             String               @id @default(uuid())
  pilotId        String               @unique
  pilot          PilotProject         @relation(fields: [pilotId], references: [id])
  decisionById   String
  decisionBy     User                 @relation(fields: [decisionById], references: [id])
  recommendation String // SCALE, EXTEND PILOT, DO NOT SCALE
  finalDecision  String
  createdAt      DateTime             @default(now())
  procurement    ProcurementRecord?
}

model ProcurementRecord {
  id              String        @id @default(uuid())
  scaleDecisionId String        @unique
  scaleDecision   ScaleDecision @relation(fields: [scaleDecisionId], references: [id])
  tenderDocUrl    String?
  status          String
  createdAt       DateTime      @default(now())
}

model Template {
  id      String @id @default(uuid())
  name    String
  type    String // e.g. TENDER_DOC, EMAIL
  content String
}

model Risk {
  id           String   @id @default(uuid())
  entityType   String   // Pilot, Startup, Challenge
  entityId     String
  reportedById String
  severity     String   // High, Medium, Low
  description  String
  status       String   // Open, Mitigated
  createdAt    DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  // nullable for system actions
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  details   String?  // JSON string
  timestamp DateTime @default(now())
}
