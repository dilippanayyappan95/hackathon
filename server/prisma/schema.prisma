generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // Admin, Government Officer, Procurement Officer, Startup, Expert, Validator, Viewer
  description String?
  users       User[]
  createdAt   DateTime @default(now())
}

model Department {
  id          String      @id @default(uuid())
  name        String      @unique
  description String?
  users       User[]
  challenges  Challenge[]
  createdAt   DateTime    @default(now())
}

model Startup {
  id               String            @id @default(uuid())
  name             String
  description      String?
  domain           String?
  technology       String?
  capabilities     String?           // Comma-separated or description of core capabilities
  experience       String?           // Track record summary
  dpiitNumber      String?
  foundedYear      Int?
  stage            String?           // Early Stage, Seed, Growth, Series A
  users            User[]
  documents        StartupDocument[]
  applications     Application[]
  pilots           PilotProject[]
  createdAt        DateTime          @default(now())
}

model User {
  id             String             @id @default(uuid())
  email          String             @unique
  password       String
  name           String
  roleId         String
  role           Role               @relation(fields: [roleId], references: [id])
  departmentId   String?
  department     Department?        @relation(fields: [departmentId], references: [id])
  startupId      String?
  startup        Startup?           @relation(fields: [startupId], references: [id])
  evaluations    Evaluation[]
  validations    ValidationRecord[]
  scaleDecisions ScaleDecision[]
  evidence       Evidence[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model StartupDocument {
  id        String   @id @default(uuid())
  startupId String
  startup   Startup  @relation(fields: [startupId], references: [id])
  name      String
  fileUrl   String
  type      String
  createdAt DateTime @default(now())
}

model Challenge {
  id                   String                 @id @default(uuid())
  departmentId         String
  department           Department             @relation(fields: [departmentId], references: [id])
  title                String
  problemStatement     String?
  description          String
  category             String?                // e.g. Healthcare, Waste Management, Smart Infrastructure
  location             String?
  budget               String?                // e.g. ₹25,00,000
  timeline             String?                // e.g. 6 Months
  targetValue          String?                // e.g. 20% reduction
  baselineValue        String?                // e.g. 135 minutes or ₹12L/month
  requiredCapabilities String?                // JSON or semicolon-separated capabilities
  eligibilityCriteria  String?                // JSON or text
  expectedOutcomes     String?                // Desired impact
  evaluationCriteria   String?                // Criteria definitions
  status               String                 // DRAFT, PUBLISHED, UNDER_EVALUATION, PILOT, COMPLETED, CLOSED
  requirements         ChallengeRequirement[]
  kpis                 ChallengeKPI[]
  applications         Application[]
  pilots               PilotProject[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @default(now()) @updatedAt
}

model ChallengeRequirement {
  id          String    @id @default(uuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  description String
  isMandatory Boolean   @default(true)
}

model ChallengeKPI {
  id          String    @id @default(uuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  name        String
  metric      String?
  baseline    String?
  target      String
  unit        String?
}

model Application {
  id               String                @id @default(uuid())
  challengeId      String
  challenge        Challenge             @relation(fields: [challengeId], references: [id])
  startupId        String
  startup          Startup               @relation(fields: [startupId], references: [id])
  solutionSummary  String?
  proposedBudget   String?
  proposedTimeline String?
  status           String                // SUBMITTED, ELIGIBILITY_REVIEW, ELIGIBLE, INELIGIBLE, SHORTLISTED, UNDER_EVALUATION, SELECTED, REJECTED
  rejectionReason  String?
  documents        ApplicationDocument[]
  evaluations      Evaluation[]
  pilots           PilotProject[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @default(now()) @updatedAt
}

model ApplicationDocument {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  name          String
  fileUrl       String
  createdAt     DateTime    @default(now())
}

model Evaluation {
  id                 String            @id @default(uuid())
  applicationId      String
  application        Application       @relation(fields: [applicationId], references: [id])
  expertId           String
  expert             User              @relation(fields: [expertId], references: [id])
  status             String            // PENDING, SUBMITTED
  overallScore       Float?
  comments           String?
  declaredNoConflict Boolean           @default(false)
  scores             EvaluationScore[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @default(now()) @updatedAt
}

model EvaluationScore {
  id           String     @id @default(uuid())
  evaluationId String
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  category     String     // e.g. Technical Feasibility, Problem Fit, Innovation, Scalability, Cost Effectiveness, Security
  score        Float
  weight       Float?     // e.g. 0.25
  comments     String?
}

model PilotProject {
  id            String             @id @default(uuid())
  challengeId   String
  challenge     Challenge          @relation(fields: [challengeId], references: [id])
  applicationId String
  application   Application        @relation(fields: [applicationId], references: [id])
  startupId     String
  startup       Startup            @relation(fields: [startupId], references: [id])
  status        String             // PLANNED, ACTIVE, EXTENDED, COMPLETED, FAILED, CANCELLED
  pilotLocation String?
  startDate     DateTime?
  endDate       DateTime?
  objectives    String?
  baseline      String?
  target        String?
  actual        String?
  risks         String?
  ownerId       String?
  kpis          PilotKPI[]
  milestones    PilotMilestone[]
  payments      Payment[]
  evidence      Evidence[]
  validations   ValidationRecord[]
  passports     ProofPassport[]
  scaleDecision ScaleDecision?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @default(now()) @updatedAt
}

model PilotKPI {
  id                String       @id @default(uuid())
  pilotId           String
  pilot             PilotProject @relation(fields: [pilotId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  unit              String?
  baseline          String?
  target            String?
  actual            String?
  measurementPeriod String?
  source            String?      // e.g. IoT Telemetry, Hospital HIS, Municipal ERP
  status            String?      // ON_TRACK, AT_RISK, ACHIEVED, MISSED
  evidence          Evidence[]
}

model PilotMilestone {
  id                  String       @id @default(uuid())
  pilotId             String
  pilot               PilotProject @relation(fields: [pilotId], references: [id], onDelete: Cascade)
  title               String
  description         String?
  dueDate             DateTime?
  completionDate      DateTime?
  amount              Float?
  status              String       // PENDING, IN_PROGRESS, COMPLETED, DELAYED, FAILED
  deliverable         String?
  evidenceRequirement String?
  payments            Payment[]
  evidence            Evidence[]
}

model Payment {
  id          String          @id @default(uuid())
  pilotId     String
  pilot       PilotProject    @relation(fields: [pilotId], references: [id])
  milestoneId String?
  milestone   PilotMilestone? @relation(fields: [milestoneId], references: [id])
  amount      Float
  status      String          // PENDING, APPROVED, PROCESSING, PAID, REJECTED
  dueDate     DateTime?
  paymentDate DateTime?
  createdAt   DateTime        @default(now())
}

model Evidence {
  id             String          @id @default(uuid())
  pilotId        String
  pilot          PilotProject    @relation(fields: [pilotId], references: [id])
  milestoneId    String?
  milestone      PilotMilestone? @relation(fields: [milestoneId], references: [id])
  kpiId          String?
  kpi            PilotKPI?       @relation(fields: [kpiId], references: [id])
  title          String?
  description    String?
  uploadedById   String
  uploadedBy     User            @relation(fields: [uploadedById], references: [id])
  fileUrl        String
  fileType       String          // PDF, CSV, Telemetry Log, Image
  verifiedStatus String          // SUBMITTED, UNDER_REVIEW, VERIFIED, REJECTED
  reviewComments String?
  reviewerId     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt
}

model ValidationRecord {
  id          String       @id @default(uuid())
  pilotId     String
  pilot       PilotProject @relation(fields: [pilotId], references: [id])
  validatorId String
  validator   User         @relation(fields: [validatorId], references: [id])
  decision    String       // PENDING, IN_REVIEW, VALIDATED, PARTIALLY_VALIDATED, REJECTED
  methodology String?      // Verification method used
  findings    String?      // Detailed findings & statistical audit notes
  confidence  String?      // High, Medium, Low
  comments    String?
  timestamp   DateTime     @default(now())
}

model ProofPassport {
  id             String       @id @default(uuid())
  pilotId        String
  pilot          PilotProject @relation(fields: [pilotId], references: [id])
  passportNumber String?      @unique // e.g. GPP-MH-2026-0042
  auditHash      String?      // SHA-256 hash
  generatedDate  DateTime     @default(now())
  dataSnapshot   String       // Complete JSON snapshot
}

model ScaleDecision {
  id             String             @id @default(uuid())
  pilotId        String             @unique
  pilot          PilotProject       @relation(fields: [pilotId], references: [id])
  decisionById   String
  decisionBy     User               @relation(fields: [decisionById], references: [id])
  recommendation String             // STOP, IMPROVE, EXTEND PILOT, PROCEED TO PROCUREMENT, SCALE
  finalDecision  String             // Official determination
  reason         String?
  comments       String?
  readinessScore Float?
  createdAt      DateTime           @default(now())
  procurement    ProcurementRecord?
}

model ProcurementRecord {
  id                        String        @id @default(uuid())
  scaleDecisionId           String        @unique
  scaleDecision             ScaleDecision @relation(fields: [scaleDecisionId], references: [id])
  tenderDocUrl              String?
  status                    String        // NOT READY, READY FOR REVIEW, PROCUREMENT READY
  specifications            String?       // JSON specifications derived from Proof Passport
  contractReadiness         String?       // READY, PENDING_LEGAL, NOT_READY
  documentationCompleteness String?       // COMPLETE, PARTIAL, MISSING
  securityReadiness         String?       // CERTIFIED, UNDER_REVIEW
  riskStatus                String?       // LOW, MEDIUM, HIGH
  createdAt                 DateTime      @default(now())
}

model Template {
  id        String   @id @default(uuid())
  name      String
  type      String   // e.g. TENDER_DOC, EMAIL, COMPLIANCE_CHECKLIST
  content   String
  createdAt DateTime @default(now())
}

model Risk {
  id           String   @id @default(uuid())
  entityType   String   // Pilot, Startup, Challenge
  entityId     String
  reportedById String
  severity     String   // High, Medium, Low
  description  String
  mitigation   String?
  status       String   // Open, Mitigated
  createdAt    DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  // nullable for system actions
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   String?  // JSON string
  timestamp DateTime @default(now())
}
